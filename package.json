{
  "name": "@emizuki/pi-bg",
  "version": "0.1.0",
  "description": "Background processes and external-condition waits for pi: run a server, wait for CI, without blocking a turn.",
  "type": "module",
  "scripts": {
    "test": "tsx --test --test-concurrency=1 test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test"
  },
  "keywords": [
    "pi-package"
  ],
  "license": "MIT",
  "files": [
    "extensions",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/emizuki/pi-bg.git"
  },
  "homepage": "https://github.com/emizuki/pi-bg#readme",
  "bugs": {
    "url": "https://github.com/emizuki/pi-bg/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "pi": {
    "extensions": [
      "./extensions"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@types/node": "^24.13.5",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  }
}
